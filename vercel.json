{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no install: site/build.py is standard library only'",
  "buildCommand": "python3 site/build.py",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/docket.ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/llms-full.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/calendar",
      "destination": "/docket.ics"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://oddsky-api-n3fpys227q-uc.a.run.app/api/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://oddsky-api-n3fpys227q-uc.a.run.app/mcp"
    },
    {
      "source": "/mcp/",
      "destination": "https://oddsky-api-n3fpys227q-uc.a.run.app/mcp"
    },
    {
      "source": "/n/:id",
      "destination": "/app"
    },
    {
      "source": "/o/:code",
      "destination": "/app"
    }
  ]
}
