{
 "taskGroups": [
  {
   "taskCount": 91,
   "parallelism": 48,
   "taskSpec": {
    "runnables": [
     {
      "container": {
       "imageUri": "python:3.12-slim",
       "entrypoint": "/bin/bash",
       "commands": [
        "-c",
        "set -euo pipefail; PIP_DISABLE_PIP_VERSION_CHECK=1 pip install -q --root-user-action=ignore --no-cache-dir numpy==2.* pandas==2.* pyarrow==21.* && python -u /mnt/disks/oddsky/code/neowise_keep.py --keep /mnt/disks/oddsky/code/keep_h0007.csv --out /mnt/disks/oddsky/runs/sky2keep --pixels-per-task 40"
       ],
       "volumes": [
        "/mnt/disks/oddsky:/mnt/disks/oddsky:rw"
       ]
      }
     }
    ],
    "volumes": [
     {
      "gcs": {
       "remotePath": "oddsky-sky-br3c3-data"
      },
      "mountPath": "/mnt/disks/oddsky"
     }
    ],
    "computeResource": {
     "cpuMilli": 2000,
     "memoryMib": 7168
    },
    "maxRetryCount": 3,
    "maxRunDuration": "7200s"
   }
  }
 ],
 "allocationPolicy": {
  "instances": [
   {
    "policy": {
     "machineType": "n2d-standard-4",
     "provisioningModel": "SPOT",
     "bootDisk": {
      "sizeGb": 30
     }
    }
   }
  ],
  "location": {
   "allowedLocations": [
    "regions/us-west1"
   ]
  },
  "serviceAccount": {
   "email": "oddsky-batch@oddsky-sky-br3c3.iam.gserviceaccount.com"
  }
 },
 "logsPolicy": {
  "destination": "CLOUD_LOGGING"
 },
 "labels": {
  "app": "oddsky",
  "hunt": "h-0007"
 }
}